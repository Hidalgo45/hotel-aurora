# Copia este archivo como .env y completa los valores.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_aurora
DB_USER=postgres
DB_PASSWORD=tu_contrasena_de_postgres

SECRET_KEY=cambia-esta-clave
FLASK_DEBUG=1

# ---- Envio del comprobante por correo ----
# "archivo" guarda el mensaje en la carpeta correos_enviados sin salir a la red
# (valor por defecto: funciona sin internet). "smtp" envia de verdad.
CORREO_BACKEND=archivo

# Solo hacen falta si CORREO_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=reservas@hotelaurora.ec
